# ---------- Stone & Design Board environment ----------
#
# Copy this file to `.env.local` (for the Next.js app) and fill in real values.
# Values marked "server-only" must NEVER be exposed to the client — keep them
# out of any NEXT_PUBLIC_* variable.
#
# After creating a hosted Supabase project at https://supabase.com/dashboard,
# find these values under: Project Settings → API, and Project Settings →
# Database (for the connection string).

# --- Public (bundled into the client) ---

# The full URL of your Supabase project, e.g. https://abcdefg.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to expose to the browser; RLS policies
# gate what it can actually read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL where this Next.js app is served. Used to build OAuth redirect
# URLs and invite links. In dev: http://localhost:3000. In production: your
# Vercel domain (e.g. https://stone-design-board.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Task 5: AI document extraction ---
#
# When set to "1", the /api/extract/[fileId] route returns canned
# extractions without calling OpenAI. Used by the extraction smoke and
# by local dev when you don't want to burn credits. Read on the SERVER
# despite the NEXT_PUBLIC_ prefix — keeping the brief's name for
# memorability.
NEXT_PUBLIC_MOCK_AI=

# Google Maps API key for the location autocomplete in the Event dialog.
# Browser-visible (NEXT_PUBLIC_*) — that's normal for the Maps JS SDK,
# which is loaded client-side.
#
# !! REFERRER RESTRICTIONS ARE MANDATORY !!
# Without them, anyone can scrape this key from your client bundle and run
# up your bill. Configure in Google Cloud Console → APIs & Services →
# Credentials → (your key) → "Application restrictions" → HTTP referrers:
#   - http://localhost:3000/*  (dev)
#   - https://your-production-domain.example.com/*  (prod)
# Also restrict "API restrictions" to "Places API (New)" only.
#
# Leave blank to fall back to a plain text input in the Event dialog
# (no autocomplete). The address still saves; the user just types it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Server-only ---

# Supabase service role key. Bypasses RLS — used ONLY by the seed script and
# by any future server-only jobs (cron, webhooks). Never import this into
# client code or a server action the user can invoke.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Prisma (`prisma generate`, `prisma db
# pull`, the seed script). Get it from Supabase → Project Settings →
# Database → "Connection string" → "URI". Use the direct connection (port
# 5432) for Prisma and seed; the transaction pooler (port 6543) is fine too
# but prefer direct for long-running scripts.
DATABASE_URL=

# Optional: your Supabase project ref (the subdomain portion of
# NEXT_PUBLIC_SUPABASE_URL). Used by `supabase link` so the CLI can push
# migrations to the hosted project.
SUPABASE_PROJECT_REF=

# --- Task 5: AI document extraction (server-only) ---
#
# OpenAI API key. Required for real extractions. Missing key surfaces
# as a one-time console.warn at server startup and every extraction
# will finish with status='failed', error_message='OpenAI key missing'.
# Use NEXT_PUBLIC_MOCK_AI=1 (above) if you want to develop the UI
# without a key. Never expose this — it's server-only.
# Get from platform.openai.com/api-keys.
OPENAI_API_KEY=

# HMAC secret for the fire-and-forget /api/extract/[fileId] kickoff
# token. When set, mint / verify use this. If unset, falls back to
# a value derived from SUPABASE_SERVICE_ROLE_KEY (dev-friendly, but
# production should set an explicit secret so key rotation doesn't
# invalidate in-flight tokens). At least 16 characters.
EXTRACTION_INTERNAL_SECRET=
